  <script>
    (function() {
      const btnContrast = document.getElementById('btn-contrast');
      const fontBtns = document.querySelectorAll('.font-btn');
      const filterBtns = document.querySelectorAll('.filter-btn');
      const searchInput = document.getElementById('search-input');
      const searchStatus = document.getElementById('search-status');
      const sections = document.querySelectorAll('.category-section');
      const cards = document.querySelectorAll('.case-card');

      let currentFilter = 'all';

      // 고대비 모드 토글
      btnContrast.addEventListener('click', function() {
        const isHigh = document.body.classList.toggle('high-contrast');
        btnContrast.setAttribute('aria-pressed', isHigh);
        btnContrast.textContent = isHigh ? '초고대비(순흑색) 모드 끄기' : '초고대비(순흑색) 모드 켜기';
      });

      // 글자 크기 조절
      fontBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          fontBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');

          document.body.classList.remove('font-125', 'font-150', 'font-200');
          const scale = btn.getAttribute('data-scale');
          if (scale !== '100') {
            document.body.classList.add('font-' + scale);
          }
        });
      });

      // 필터 및 검색 통합 적용
      function applyFilterAndSearch() {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        sections.forEach(function(sec) {
          const group = sec.getAttribute('data-group');
          const groupMatch = (currentFilter === 'all' || currentFilter === group);

          if (!groupMatch) {
            sec.classList.add('hidden');
            return;
          }

          let secHasVisibleCard = false;
          const secCards = sec.querySelectorAll('.case-card');

          secCards.forEach(function(card) {
            const text = card.textContent.toLowerCase();
            if (!query || text.includes(query)) {
              card.classList.remove('hidden');
              secHasVisibleCard = true;
              visibleCount++;
            } else {
              card.classList.add('hidden');
            }
          });

          if (secHasVisibleCard) {
            sec.classList.remove('hidden');
          } else {
            sec.classList.add('hidden');
          }
        });

        if (query) {
          searchStatus.textContent = "'" + searchInput.value.trim() + "' 검색 결과: 총 " + visibleCount + "개 항목이 표시됩니다.";
        } else {
          searchStatus.textContent = "현재 " + visibleCount + "개 항목이 표시되고 있습니다.";
        }
      }

      filterBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          filterBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          currentFilter = btn.getAttribute('data-filter');
          applyFilterAndSearch();
        });
      });

      searchInput.addEventListener('input', applyFilterAndSearch);

      // 첫 화면에서도 항목 수를 실제 값으로 계산한다(고정 문구가 낡지 않게)
      applyFilterAndSearch();
    })();
  </script>
