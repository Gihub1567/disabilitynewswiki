  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.min.css" />
  <style>
    :root {
      /* 눈부심을 줄인 차분한 다크 슬레이트 톤 기본 테마 */
      --bg: #161920;
      --surface: #1f242e;
      --surface-alt: #282f3c;
      --text: #eef2f6;
      --text-muted: #b4c0d0;
      --primary: #7cc0ff;
      --primary-hover: #a5d4ff;
      --primary-bg: #1e2d42;
      --border: #364052;
      --badge-bg: #2c3545;
      --badge-text: #e2e8f0;
      --focus-ring: #fbbf24;
      --font-scale: 1;
    }

    /* 초고대비(순흑색 배경 + 순백색/노란색 강조) 모드 */
    body.high-contrast {
      --bg: #000000;
      --surface: #0d0d0d;
      --surface-alt: #1a1a1a;
      --text: #ffffff;
      --text-muted: #e5e7eb;
      --primary: #fde047;
      --primary-hover: #fef08a;
      --primary-bg: #1f1b08;
      --border: #737373;
      --badge-bg: #262626;
      --badge-text: #ffffff;
      --focus-ring: #fde047;
    }

    body.font-125 { --font-scale: 1.25; }
    body.font-150 { --font-scale: 1.5; }
    body.font-200 { --font-scale: 2; }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg);
      color: var(--text);
      font-family: "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: calc(17px * var(--font-scale));
      line-height: 1.78;
      letter-spacing: -0.01em;
      word-break: keep-all;
      overflow-wrap: break-word;
      -webkit-font-smoothing: antialiased;
    }

    .skip-link {
      position: absolute;
      top: -60px;
      left: 16px;
      background: var(--primary);
      color: #0b0e14;
      padding: 10px 16px;
      font-weight: 700;
      text-decoration: none;
      border-radius: 6px;
      z-index: 1000;
    }
    .skip-link:focus {
      top: 16px;
      outline: 3px solid var(--focus-ring);
    }

    a:focus, button:focus, input:focus {
      outline: 3px solid var(--focus-ring);
      outline-offset: 2px;
    }

    .container {
      max-width: 920px;
      margin: 0 auto;
      padding: 24px 20px 80px;
    }

    /* 접근성 및 검색 컨트롤 영역 */
    .toolbar {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px;
      margin-bottom: 28px;
    }

    .toolbar-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-bottom: 14px;
    }

    .toolbar-row:last-child {
      margin-bottom: 0;
    }

    .toolbar-label {
      font-weight: 700;
      font-size: 0.92em;
      color: var(--text-muted);
      margin-right: 4px;
    }

    .btn {
      background: var(--surface-alt);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 9px 15px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.92em;
      font-weight: 600;
      cursor: pointer;
      min-height: 42px;
    }

    .btn:hover {
      border-color: var(--primary);
    }

    .btn[aria-pressed="true"], .btn.active {
      background: var(--primary);
      color: #0b0e14;
      border-color: var(--primary);
      font-weight: 700;
    }

    .search-box {
      width: 100%;
      padding: 12px 14px;
      font-family: inherit;
      font-size: 1em;
      border: 2px solid var(--border);
      border-radius: 8px;
      background: var(--bg);
      color: var(--text);
    }

    .search-box::placeholder {
      color: var(--text-muted);
      opacity: 0.8;
    }

    .search-status {
      font-size: 0.92em;
      color: var(--text-muted);
      margin-top: 8px;
    }

    header.page-header {
      border-bottom: 2px solid var(--border);
      padding-bottom: 20px;
      margin-bottom: 28px;
    }

    h1 {
      font-size: 1.8em;
      font-weight: 800;
      line-height: 1.38;
      margin: 0 0 12px;
      color: #ffffff;
    }

    .meta-info {
      font-size: 0.94em;
      color: var(--text-muted);
    }

    /* 목차 영역 */
    nav.toc {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 22px;
      margin-bottom: 38px;
    }

    nav.toc h2 {
      margin-top: 0;
      font-size: 1.32em;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
    }

    nav.toc h3 {
      font-size: 1.1em;
      margin: 20px 0 10px;
      color: var(--primary);
    }

    nav.toc ul {
      margin: 0;
      padding-left: 22px;
    }

    nav.toc li {
      margin-bottom: 8px;
    }

    nav.toc a {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    nav.toc a:hover {
      color: var(--primary);
    }

    /* 목차 접기·펼치기 (2026-11-22) — details 요소를 써서 자바스크립트 없이 동작한다 */
    nav.toc details {
      margin-bottom: 6px;
    }

    nav.toc summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--primary);
      padding: 2px 0;
    }

    nav.toc summary:hover {
      color: var(--primary-hover);
    }

    nav.toc details[open] > summary {
      margin-bottom: 6px;
    }

    nav.toc .toc-part-link {
      font-weight: 600;
    }

    /* 본문 섹션 */
    section.category-section {
      margin-bottom: 48px;
    }

    section.category-section > h2 {
      font-size: 1.48em;
      background: var(--primary-bg);
      color: var(--primary);
      padding: 14px 18px;
      border-left: 5px solid var(--primary);
      border-radius: 6px;
      margin-bottom: 14px;
    }

    .category-desc {
      color: var(--text-muted);
      margin-bottom: 22px;
      padding: 0 4px;
    }

    article.case-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 22px;
      margin-bottom: 22px;
    }

    article.case-card h3 {
      margin-top: 0;
      font-size: 1.24em;
      font-weight: 700;
      color: #ffffff;
      border-bottom: 1px solid var(--border);
      padding-bottom: 12px;
      margin-bottom: 16px;
    }

    article.case-card strong {
      color: var(--primary);
      font-weight: 700;
    }

    article.case-card ul {
      margin: 0;
      padding-left: 22px;
    }

    article.case-card li {
      margin-bottom: 10px;
    }

    article.case-card ul ul {
      margin-top: 8px;
      margin-bottom: 8px;
    }

    .note-ref {
      display: inline-block;
      max-width: 100%;
      overflow-wrap: anywhere;
      background: var(--badge-bg);
      color: var(--badge-text);
      border: 1px solid var(--border);
      padding: 3px 9px;
      border-radius: 6px;
      font-size: 0.88em;
      font-weight: 600;
      margin: 2px 4px 2px 0;
    }

    .source-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
    }

    .source-links > * {
      min-width: 0;
    }

    .source-link {
      display: inline-block;
      max-width: 100%;
      overflow-wrap: anywhere;
      background: var(--primary-bg);
      color: var(--primary);
      border: 1px solid var(--primary);
      padding: 4px 12px;
      border-radius: 6px;
      font-size: 0.88em;
      font-weight: 700;
      text-decoration: none;
    }

    .source-link:hover {
      background: var(--primary);
      color: #0b0e14;
    }

    .back-to-top {
      display: inline-block;
      margin-top: 12px;
      font-size: 0.9em;
      font-weight: 600;
      color: var(--primary);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .hidden {
      display: none !important;
    }

    .section-top {
      margin-top: 22px;
    }

    /* 넓은 화면에서만 목차를 왼쪽에 고정한다 (2026-11-22 결정: B안).
       좁은 화면과 글자 확대 상태에서는 지금처럼 위쪽 목차를 그대로 쓴다. */
    @media (min-width: 1180px) {
      #top.container {
        max-width: min(1760px, 95vw);
        padding-left: 28px;
        padding-right: 28px;
      }

      /* 본문은 1320px까지만 넓히고 남는 폭은 좌우 여백으로 돌린다.
         한 줄이 너무 길어지면 시선이 좌우로 크게 움직여 읽기 어려워진다(측정: 1920px 화면에서 86자 vs 75자). */
      #main-content {
        display: grid;
        grid-template-columns: 400px minmax(0, 1320px);
        column-gap: 44px;
        justify-content: center;
      }

      #main-content > nav.toc {
        grid-column: 1;
        grid-row: 1 / span 99;
        align-self: start;
        position: sticky;
        top: 16px;
        max-height: calc(100vh - 32px);
        overflow-y: auto;
      }

      #main-content > :not(nav.toc) {
        grid-column: 2;
      }
    }
  </style>
</head>
